(version 1)
(rule "Trace Width - JLCPCB"
  (condition "A.Type == 'Track'")
  (constraint track_width (min 0.1016mm)))
(rule "Clearance - JLCPCB"
  (constraint clearance (min 0.1016mm)))
(rule "Via Drill - JLCPCB"
  (condition "A.Type == 'Via'")
  (constraint hole_size (min 0.2mm)))
(rule "Via Diameter - JLCPCB"
  (condition "A.Type == 'Via'")
  (constraint via_diameter (min 0.45mm)))
(rule "Annular Ring - JLCPCB"
  # JLCPCB lists multilayer 1 oz annular ring as 0.20mm recommended,
  # with 0.15mm as the absolute minimum.
  (constraint annular_width (min 0.15mm)))
(rule "Copper to Edge - JLCPCB"
  # Routed-edge copper clearance. JLCPCB lists routed-edge copper clearance
  # as >=0.20mm; V-cut panelization would require >=0.40mm.
  (constraint edge_clearance (min 0.2mm)))
(rule "Silkscreen Width - JLCPCB"
  (condition "A.Type == 'Text' && (A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS')")
  (constraint text_thickness (min 0.15mm)))
(rule "Silkscreen Height - JLCPCB"
  (condition "A.Type == 'Text' && (A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS')")
  (constraint text_height (min 1.0mm)))
(rule "Solder Mask Clearance - JLCPCB"
  # JLCPCB supports 1:1 soldermask expansion for standard FR-4.
  (constraint solder_mask_expansion (opt 0mm)))
